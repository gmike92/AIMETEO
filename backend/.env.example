# Copy to .env for local dev. In prod, inject via Secret Manager / Cloud Run env vars.
APP_ENV=local
GCP_PROJECT=
GCP_REGION=europe-west1

# Route store: empty = in-memory seed store (offline dev).
# Set a Postgres DSN to use the real DB (Cloud SQL in prod, any Postgres locally), e.g.
# DATABASE_URL=postgresql://aimeteo:aimeteo@localhost:5432/aimeteo
DATABASE_URL=
DB_POOL_MAX=4

# Feature flags
USE_MOCK_DATA=true          # true = no external calls (skeleton). Set false when wiring providers.
TRIP_PLANNER_ENABLED=true

# Providers (leave blank while USE_MOCK_DATA=true)
MAPS_WEATHER_API_KEY=
WEATHER_API_BASE=https://weather.googleapis.com/v1
FORECAST_CACHE_TTL_MIN=30
VERTEX_MODEL=gemini-2.0-flash
VERTEX_LOCATION=europe-west1     # Vertex region (can differ from GCP_REGION)
EE_DEM_ASSET=COPERNICUS/DEM/GLO30

# Cloud Scheduler shared secret for POST /alert/run (empty = no check, local dev only)
SCHEDULER_TOKEN=

# Market
DEFAULT_COUNTRY=IT
DEFAULT_LOCALE=it

# CORS allowed origins for non-local envs (comma-separated). Local allows all.
# e.g. CORS_ORIGINS=https://app.zerotermico.it,https://zerotermico.it
CORS_ORIGINS=
