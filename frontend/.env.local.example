# Copy to .env.local. Point at your running backend.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Free CARTO basemap key (Voyager + Dark Matter raster tiles) — without it
# the map still works but shows an "API KEY REQUIRED" watermark. Get one
# (no approval, no account) at https://carto.com/basemaps/apikey/ — free
# tier covers 5M tile requests/month.
NEXT_PUBLIC_CARTO_API_KEY=